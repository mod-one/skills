{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MACC final compliance audit report",
  "type": "object",
  "required": ["decision", "scope", "summary", "traceability", "findings", "evidence_reviewed", "unverified_items", "recommended_next_steps"],
  "properties": {
    "decision": {"enum": ["approved", "changes_requested", "blocked"]},
    "scope": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": {"enum": ["feature", "shared-foundation", "task", "release", "unknown"]},
        "id": {"type": "string"},
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "summary": {"type": "string"},
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "requirement", "expected", "implementation_evidence", "verification_evidence", "result"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "requirement": {"type": "string"},
          "expected": {"type": "string"},
          "implementation_evidence": {"type": "array", "items": {"type": "string"}},
          "verification_evidence": {"type": "array", "items": {"type": "string"}},
          "result": {"enum": ["passed", "failed", "partial", "unverified"]}
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "dimension", "requirement", "location", "expected", "observed", "evidence", "impact", "suggested_fix"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["blocking", "major", "minor", "advisory"]},
          "dimension": {"type": "string"},
          "requirement": {"type": "string"},
          "location": {"type": "string"},
          "expected": {"type": "string"},
          "observed": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "impact": {"type": "string"},
          "suggested_fix": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "evidence_reviewed": {"type": "array", "items": {"type": "string"}},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "recommended_next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
